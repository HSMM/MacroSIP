<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Ad-hoc signed builds embed Sparkle.framework, which has no Team ID; without this the hardened
     runtime refuses to load it. Remove once the app is signed with a Developer ID. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Directory source "macOS Contacts" (screen 13): the hardened runtime blocks the Contacts prompt without it. -->
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
</dict>
</plist>
