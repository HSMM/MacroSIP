-            pj_str_t IN6_ADDR_ANY = {"0", 1};
+            pj_str_t IN6_ADDR_ANY = {"::", 2};
+            /* An IPv6 component binds like the IPv4 one: to the account's
+             * bound address when that is an IPv6 address, else to any. */
+            const pj_str_t *bound6 = pj_strchr(&cfg->bound_addr, ':') ?
+                                     &cfg->bound_addr : &IN6_ADDR_ANY;
 
